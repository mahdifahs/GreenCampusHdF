# Copier ce fichier en .env puis adapter les valeurs.
DATABASE_URL=postgresql://greencampus:greencampus@localhost:5432/greencampus
# Générer un secret : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-un-secret-de-plus-de-32-caracteres
TOKEN_TTL=60d
PORT=4000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_INSCRIPTION_PAR_MIN=60
RATE_LIMIT_CONNEXION_PAR_MIN=20
# Documentation Swagger (/docs) : activée par défaut en développement, désactivée en production.
# DOCS_ENABLED=true
# Nombre de reverse proxys devant l'API (Caddy = 1) : 1 par défaut en production, 0 en développement.
# TRUST_PROXY=1
# Seuil d'anonymat : une filière n'apparaît au tableau de bord qu'à partir de ce nombre de participants.
SEUIL_ANONYMAT=5
# Durée de cache du tableau de bord (secondes).
TABLEAU_CACHE_SECONDES=10
# Notifications de relance (Web Push). Générer les clés : npx web-push generate-vapid-keys
# Laisser vide pour désactiver les notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUJET=mailto:contact@example.org
# Fréquence de vérification des relances à envoyer (minutes).
RELANCE_INTERVALLE_MIN=60
# Délai minimum (heures) entre le choix d'un défi et sa validation « Tenu ». 0 = aucun délai.
DEFI_DELAI_VALIDATION_HEURES=24
# Routes de test /api/dev (vieillir ses bilans, déclencher les relances) : activées par défaut en développement,
# jamais en production.
# DEMO_ENABLED=true

# Interface d'administration (/admin/) : desactivee par defaut, a activer explicitement.
ADMIN_ENABLED=false
ADMIN_SESSION_TTL=12h
# Nombre maximum de comptes admin pouvant exister en meme temps.
ADMIN_LIMITE_COMPTES=3
# Comptes « bénévole » (Jour J et vêtements seulement), comptés à part des admins.
ADMIN_LIMITE_BENEVOLES=5
# Tentatives de connexion admin autorisees par minute et par IP (anti force brute reseau).
ADMIN_RATE_LIMIT_CONNEXION_PAR_MIN=5
# Amorcage du tout premier compte (SUPER_ADMIN), lu une seule fois par `npm run db:seed` quand
# aucun compte admin n'existe encore (voir prisma/seed-super-admin.ts). Mot de passe : 12
# caracteres minimum. A retirer du .env une fois le compte cree ; les comptes suivants se
# creent ensuite depuis l'onglet « Comptes admin » de l'administration.
ADMIN_SUPER_PRENOM=
ADMIN_SUPER_MOT_DE_PASSE=
